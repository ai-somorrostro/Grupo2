{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "grafana": {
      "type": "local",
      "command": [
        "docker",
        "exec",
        "-i",
        "mcp-grafana",
        "/app/mcp-grafana",
        "-t",
        "stdio"
      ],
      "enabled": true
    },
    "steamwebapi": {
      "type": "remote",
      "url": "https://mcp.steamwebapi.com/mcp",
      "enabled": true
    }
  }
}
