                        "query": "from(bucket: \"Copia seguridad\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"steam_data\")\r\n  |> filter(fn: (r) => r[\"_field\"] == \"players\" or r[\"_field\"] == \"average_players\")\r\n  |> filter(fn: (r) => r[\"game\"] == \"Among Us\" or r[\"game\"] == \"Counter-Strike 2\")\r\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\r\n  |> yield(name: \"mean\")"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
