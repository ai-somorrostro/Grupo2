# InfluxDB
DOCKER_INFLUXDB_INIT_USERNAME=tu_usuario_influxdb
DOCKER_INFLUXDB_INIT_PASSWORD=tu_contraseña_influxdb
DOCKER_INFLUXDB_INIT_ORG=tu_organizacion_influxdb
DOCKER_INFLUXDB_INIT_BUCKET=Gamedata
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=tu_token_admin_influxdb

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=tu_contraseña_admin_grafana

# Alertas por correo (opcional)
GF_SMTP_ENABLED=false
# GF_SMTP_HOST=smtp.gmail.com:587
# GF_SMTP_USER=tu_correo@gmail.com
# GF_SMTP_PASSWORD=tu_contraseña_de_aplicacion_google
# GF_SMTP_FROM_ADDRESS=tu_correo@gmail.com

# Node-RED
NODE_RED_CREDENTIAL_SECRET=tu_clave_secreta_nodered
