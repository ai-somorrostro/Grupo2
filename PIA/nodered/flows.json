    {
        "id": "44f6421154d184d0",
        "type": "function",
        "z": "3c7d0d72b3ff751f",
        "name": "Funcion API",
        "func": "const resp = msg.payload && msg.payload.response;\n\nif (!resp || typeof resp.player_count !== \"number\") {\n    node.warn(\"Sin dato para \" + msg.game);\n    return null;\n}\n\nmsg.players = resp.player_count;\n\nmsg.payload = [\n    { players: resp.player_count },\n    { game: msg.game, appid: String(msg.appid) }\n];\n\nnode.status({ fill: \"green\", shape: \"dot\", text: msg.game + \": \" + resp.player_count });\nreturn msg;",
