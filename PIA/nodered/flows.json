        "name": "function 1",
        "func": "const games = [\n    { appid: 440, game: \"Team Fortress 2\" },\n    { appid: 105600, game: \"Terraria\" },\n    { appid: 570, game: \"Dota 2\" },\n    { appid: 730, game: \"Counter-Strike 2\" },\n    { appid: 108600, game: \"Project Zomboid\" },\n    { appid: 252490, game: \"Rust\" },\n    { appid: 413150, game: \"Stardew Valley\" },\n    { appid: 367520, game: \"Hollow Knight\" },\n    { appid: 578080, game: \"PUBG\" },\n    { appid: 945360, game: \"Among Us\" }\n];\n\nreturn [games.map(g => ({\n    appid: g.appid,\n    game: g.game,\n    url: `https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=${g.appid}`\n}))];",
